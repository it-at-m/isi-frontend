{
  "name": "isi-frontend",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build --out-dir dist",
    "test:unit": "vitest run",
    "prepare": "husky",
    "check": "npx prettier \"**/*\" --check --ignore-unknown",
    "lint": "npx prettier \"**/*\" --write --ignore-unknown"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.9",
    "async-mutex": "^0.5.0",
    "core-js": "^3.47.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.nontiledlayer": "^1.0.9",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "pinia": "^3.0.4",
    "uuid": "^13.0.0",
    "vue": "^3.5.13",
    "vue-currency-input": "^3.2.1",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^4.0.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/leaflet": "^1.9.21",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.10.4",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.6.2",
    "eslint-plugin-vuetify": "^2.5.3",
    "husky": "9.1.7",
    "jsdom": "^29.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "3.8",
    "prettier-plugin-java": "2.8",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
