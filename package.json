    "check": "npx prettier \"**/*\" --check --ignore-unknown",
    "lint": "npx prettier \"**/*\" --write --ignore-unknown"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "15.4.3",
    "prettier": "3.5.2",
    "prettier-plugin-java": "2.6.7",
    "vite": "^7.1.7"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
