{
  "name": "isi-frontend",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "build": "vite build --out-dir dist",
    "test:unit": "vitest run",
    "prepare": "husky",
    "check": "npx prettier \"**/*\" --check --ignore-unknown",
    "lint": "npx prettier \"**/*\" --write --ignore-unknown"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.1.1",
    "async-mutex": "^0.5.0",
    "core-js": "^3.40.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "leaflet.nontiledlayer": "^1.0.9",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "pinia": "^3.0.1",
    "uuid": "^13.0.0",
    "vue": "^3.5.13",
    "vue-currency-input": "^3.2.1",
    "vue-router": "^4.5.0",
    "vue-toastification": "^2.0.0-rc.5",
    "vuetify": "^3.7.12"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/leaflet": "^1.9.20",
    "@types/lodash": "^4.17.15",
    "@types/node": "^24.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "^10.4.0",
    "eslint-plugin-vuetify": "^2.5.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.1.3",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.0.6",
    "husky": "9.1.7",
    "lint-staged": "^16.1.5",
    "prettier": "3.6",
    "prettier-plugin-java": "2.7"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
